# Chuẩn hoá ký tự xuống dòng.
# Trong kho luôn lưu LF; khi lấy ra máy Windows, Git tự đổi sang CRLF.
# Nhờ vậy làm trên Windows, Linux hay macOS đều không sinh diff rác.
* text=auto

# Buộc LF cho những file phải giữ nguyên định dạng
*.sh   text eol=lf
*.java text eol=lf
*.sql  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.py   text eol=lf

# File nhị phân — Git không được đụng vào nội dung
*.woff2 binary
*.woff  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
